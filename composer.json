{
    "name": "justinholtweb/craft-nuke",
    "description": "Delete content in bulk — whole sections, drafts, revisions and relations — behind a dry run, a typed confirmation and a backup. Then keep the site clean with scheduled sweeps.",
    "type": "craft-plugin",
    "version": "5.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "nuke",
        "delete",
        "bulk delete",
        "cleanup",
        "garbage collection",
        "maintenance",
        "drafts",
        "revisions",
        "housekeeping"
    ],
    "license": "proprietary",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "docs": "https://craft-nuke.com/docs",
        "source": "https://github.com/justinholtweb/craft-nuke",
        "issues": "https://github.com/justinholtweb/craft-nuke/issues"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\nuke\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "justinholtweb\\nuke\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "craftcms/generator": true
        }
    },
    "extra": {
        "name": "Nuke",
        "handle": "nuke",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://craft-nuke.com/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-nuke/main/CHANGELOG.md",
        "class": "justinholtweb\\nuke\\Plugin"
    }
}
